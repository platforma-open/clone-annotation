test := import("@platforma-sdk/workflow-tengo:test")
sequenceCols := import(":sequence-cols")
pairCols := import(":pair-cols")
cloneCols := import(":clone-cols")
plateCols := import(":plate-cols")
readCols := import(":read-cols")
wellCols := import(":well-cols")

hasColumn := func(settings, name) {
	for c in settings.columns {
		if c.spec.name == name {
			return true
		}
	}
	return false
}

// The model finds each table's anchor by this exact name. A rename on one side
// alone leaves the page empty with no error anywhere, so the names are pinned.
TestEachTableCarriesTheColumnTheModelAnchorsOn := func() {
	test.isTrue(hasColumn(sequenceCols.settings(undefined), "pl7.app/vdj/sequence/well"))
	test.isTrue(hasColumn(pairCols.settings(), "pl7.app/vdj/pair/well"))
	test.isTrue(hasColumn(cloneCols.settings(undefined), "pl7.app/vdj/clone/wellCount"))
	test.isTrue(hasColumn(plateCols.settings(), "pl7.app/vdj/qc/wells"))
	test.isTrue(hasColumn(readCols.settings(), "pl7.app/vdj/qc/read/meanQuality"))
	test.isTrue(hasColumn(readCols.settings(), "pl7.app/vdj/qc/read/usableLength"))
	test.isTrue(hasColumn(readCols.settings(), "pl7.app/vdj/qc/read/plate"))
}

TestTheTablesDoNotShareAnAxis := func() {
	names := {}
	names[sequenceCols.axisSpec.name] = true
	names[pairCols.axisSpec.name] = true
	names[cloneCols.axisSpec.name] = true
	names[plateCols.axisSpec.name] = true
	names[readCols.axisSpec.name] = true
	test.isEqual(5, len(names))
}

// The share is a fraction; only the format makes it read as a percent.
TestTheGoodShareShowsAsAPercent := func() {
	for c in plateCols.settings().columns {
		if c.column == "passedShare" {
			test.isEqual(".0%", c.spec.annotations["pl7.app/format"])
			test.isEqual("Double", c.spec.valueType)
		}
	}
}

descriptionOf := func(settings, column) {
	for c in settings.columns {
		if c.column == column {
			return c.spec.annotations["pl7.app/description"]
		}
	}
	return "no such column"
}

TestResultColumnsCarryTheirTooltips := func() {
	props := [{ name: "Titer", type: "Double" }]
	test.isEqual("Positions where the forward and reverse reads overlap but call different bases.",
		descriptionOf(sequenceCols.settings(undefined), "mismatches"))
	test.isEqual(descriptionOf(sequenceCols.settings(undefined), "source"),
		descriptionOf(pairCols.settings(), "heavy_source"))
	test.isEqual(descriptionOf(sequenceCols.settings(undefined), "detectedChain"),
		descriptionOf(cloneCols.settings(props), "light_chain"))
	test.isEqual("The highest of the wells' values.", descriptionOf(cloneCols.settings(props), "prop_0_max"))
	test.isTrue(is_undefined(descriptionOf(cloneCols.settings(props), "cloneId")), "no tooltip on Clone Id")
	test.isTrue(is_undefined(descriptionOf(sequenceCols.settings(undefined), "plate")), "none where the name says it")
}

// The UI reads the verdict column's axes as plate, row and column, in that order.
TestThePlateMapIsKeyedByPlateRowAndColumn := func() {
	s := wellCols.settings([{ name: "Titer", type: "Double" }])
	test.isEqual("pl7.app/vdj/plateMap/plate", s.axes[0].spec.name)
	test.isEqual("pl7.app/vdj/plateMap/row", s.axes[1].spec.name)
	test.isEqual("pl7.app/vdj/plateMap/column", s.axes[2].spec.name)
	test.isEqual("Int", s.axes[2].spec.type)
	verdict := s.columns[0].spec
	test.isEqual("pl7.app/vdj/plateMap/verdict", verdict.name)
	test.isTrue(!is_undefined(verdict.annotations["pl7.app/graph/palette"]), "the verdict has its colours")
	test.isEqual("Double", s.columns[len(s.columns) - 1].spec.valueType)
}
