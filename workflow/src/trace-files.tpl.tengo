// The `.ab1` file the sequence viewer shows per variant and chain, re-keyed from the
// staged trace ids onto [variantKey], one resource map per chain.
//
// A separate template because the key is known only once the annotator has run: a
// variant's key is a digest of its sequences. Which read stands for it arrives as file
// content, which a template can read only after waiting for it. The files themselves are
// the uploaded blobs, not copies.

self := import("@platforma-sdk/workflow-tengo:tpl")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
exportSpecs := import(":export-specs")
json := import("json")
text := import("text")

self.defineOutputs("traceFiles")

self.awaitState("traces", "ResourceReady")
self.awaitState("traceReads", "ResourceReady")
self.awaitState("pairing", "ResourceReady")

self.body(func(inputs) {
	// The staged id of each trace, by the path the annotator names it under.
	idOf := inputs.params.idOf
	sideOf := { A: "heavy", B: "light" }

	blobs := {}
	for key, blob in inputs.traces.inputs() {
		blobs[string(json.decode(key)[0])] = blob
	}

	maps := {
		heavy: pcolumn.resourceMapBuilder(1),
		light: pcolumn.resourceMapBuilder(1)
	}
	// `variantKey\tchain\tpath`, header first.
	lines := text.split(text.trim_space(string(inputs.traceReads.getData())), "\n")
	for i := 1; i < len(lines); i++ {
		fields := text.split(lines[i], "\t")
		if len(fields) < 3 || fields[0] == "" {
			continue
		}
		side := sideOf[fields[1]]
		// A per-file read is keyed by its path. A combined file's read is keyed
		// "path#index", but the staged blob is the whole file, so the suffix is
		// dropped to find it.
		raw := text.trim_space(fields[2])
		fileId := idOf[raw]
		if is_undefined(fileId) {
			cut := text.last_index(raw, "#")
			if cut >= 0 {
				fileId = idOf[raw[:cut]]
			}
		}
		blob := is_undefined(fileId) ? undefined : blobs[fileId]
		if is_undefined(side) || is_undefined(blob) {
			continue
		}
		maps[side].add([fields[0]], blob)
	}

	// The key axis carries the run's pairing, which annotate writes as a file. The
	// spec must match the variants frame's axis, so it is built here, after the
	// file is ready, and not in the caller, which cannot await it.
	pairing := inputs.pairing.getDataAsJson()
	trace := exportSpecs.datasetTrace(inputs.params.blockId, inputs.params.label)
	built := { heavy: maps.heavy.build(), light: maps.light.build() }
	frame := pframes.pFrameBuilder()
	for side in ["heavy", "light"] {
		frame.add(side + "_trace_file",
			trace.inject(exportSpecs.traceFileColumn(
				inputs.params.blockId, side, inputs.params.aminoAcid, pairing)),
			built[side])
	}
	return { traceFiles: frame.build() }
})
