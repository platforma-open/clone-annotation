// The shape this block puts in the result pool.
//
// One frame. The record key is axis 0, because downstream sequence selectors
// match axes positionally and an output keyed otherwise is never offered to
// them. The two chains of a paired record are separated by the
// `pl7.app/vdj/scClonotypeChain` column domain, never by an axis and never by a
// second frame. Only abundance carries the sample axis.

maps := import("@platforma-sdk/workflow-tengo:maps")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
strings := import("@platforma-sdk/workflow-tengo:strings")
json := import("json")

CHAINS := ["IGHeavy", "IGLight"]
CHAIN_OF := { heavy: "IGHeavy", light: "IGLight" }
SIDE := { IGHeavy: "heavy", IGLight: "light" }
LABEL := { IGHeavy: "Heavy", IGLight: "Light" }
PAIRED_DOMAIN := { IGHeavy: "A", IGLight: "B" }
RECEPTOR := "IG"

FEATURES := ["VDJRegion", "FR1", "CDR1", "FR2", "CDR2", "FR3", "CDR3", "FR4"]
ALPHABETS := { aa: "aminoacid", nt: "nucleotide" }
GENES := [
	{ gene: "vGene", hit: "vHit", reference: "VGene", label: "V" },
	{ gene: "dGene", hit: "dHit", reference: "DGene", label: "D" },
	{ gene: "jGene", hit: "jHit", reference: "JGene", label: "J" },
	{ gene: "cGene", hit: "cHit", reference: "CGene", label: "C" }
]

// The constant-region classes MiXCR calls from `-isotype primary`.
ISOTYPES := ["IgA", "IgD", "IgG", "IgE", "IgM"]

// The mixcr-clonotyping per-clone germline columns, one per side. `field` is the
// column annotate.py writes. The V and J mutation columns carry a gene domain;
// the three cross-region scores and the fraction do not. The names and value
// types match mixcr-clonotyping so a consumer treats these clones the same way.
// Labels follow mixcr-clonotyping's wording in title case, with this block's own
// Heavy/Light prefix added (germlineColumns), since one frame holds both chains.
MUTATIONS := [
	{ field: "vNtMutCount", name: "pl7.app/vdj/sequence/nMutationsCount", type: "Int", gene: "V", label: "NT Mutations Count in V Gene" },
	{ field: "vNtMutRate", name: "pl7.app/vdj/sequence/nMutationsRate", type: "Double", gene: "V", label: "NT Mutations Rate in V Gene" },
	{ field: "vAaMutCount", name: "pl7.app/vdj/sequence/aaMutationsCount", type: "Int", gene: "V", label: "AA Mutations Count in V Gene" },
	{ field: "vAaMutRate", name: "pl7.app/vdj/sequence/aaMutationsRate", type: "Double", gene: "V", label: "AA Mutations Rate in V Gene" },
	{ field: "jNtMutCount", name: "pl7.app/vdj/sequence/nMutationsCount", type: "Int", gene: "J", label: "NT Mutations Count in J Gene" },
	{ field: "jNtMutRate", name: "pl7.app/vdj/sequence/nMutationsRate", type: "Double", gene: "J", label: "NT Mutations Rate in J Gene" },
	{ field: "jAaMutCount", name: "pl7.app/vdj/sequence/aaMutationsCount", type: "Int", gene: "J", label: "AA Mutations Count in J Gene" },
	{ field: "jAaMutRate", name: "pl7.app/vdj/sequence/aaMutationsRate", type: "Double", gene: "J", label: "AA Mutations Rate in J Gene" },
	{ field: "nMutations", name: "pl7.app/vdj/sequence/nMutations", type: "Int", score: "decreasing", label: "NT Mutations" },
	{ field: "nAaMutCDR", name: "pl7.app/vdj/sequence/nAAMutationsCDR", type: "Int", score: "decreasing", label: "AA Mutations (CDR)" },
	{ field: "nAaMutFWR", name: "pl7.app/vdj/sequence/nAAMutationsFWR", type: "Int", score: "increasing", label: "AA Mutations (FWR)" },
	{ field: "fractionCDRMutations", name: "pl7.app/vdj/sequence/fractionCDRMutations", type: "Double", score: "decreasing", format: ".2f", label: "CDR Mutation Fraction" }
]

// Length columns, matching mixcr-clonotyping. CDR3 lengths come from the regions
// the block built; the junction lengths come from MiXCR and the total added is
// summed from them. CDR3 uses MiXCR's not-covered token, the junctions a
// lowercase one. All are nucleotide counts except the CDR3 amino-acid length.
LENGTHS := [
	{ field: "cdr3LenNt", feature: "CDR3", alphabet: "nucleotide", na: "region_not_covered", label: "Length of CDR3 nt" },
	{ field: "cdr3LenAa", feature: "CDR3", alphabet: "aminoacid", na: "region_not_covered", label: "Length of CDR3 aa" },
	{ field: "vjJunctionLen", feature: "VJJunction", alphabet: "nucleotide", na: "^[a-z_]*$", label: "Length of VJ Junction nt" },
	{ field: "vdJunctionLen", feature: "VDJunction", alphabet: "nucleotide", na: "^[a-z_]*$", label: "Length of VD Junction nt" },
	{ field: "djJunctionLen", feature: "DJJunction", alphabet: "nucleotide", na: "^[a-z_]*$", label: "Length of DJ Junction nt" },
	{ field: "totalAddedNt", alphabet: "nucleotide", na: "^[a-z_]*$", label: "Total Number of Added nt" }
]

// Read nucleotides outside the domain, per side. The clone sequence is the domain only,
// so these say how much real read it leaves out: the 5' leader (signal peptide / vector)
// and the 3' tail (usually the constant region). Empty where the domain could not be placed.
FLANKS := [
	{ field: "flank5Nt", end: "5", label: "Read nt before the Domain" },
	{ field: "flank3Nt", end: "3", label: "Read nt after the Domain" }
]

// The ids in the Segments annotation markup, as mixcr-clonotyping maps them.
SEGMENTS_MAPPING := "{\"1\":\"V\",\"2\":\"D\",\"3\":\"J\",\"4\":\"C\"}"

SUMMARY_LABEL := { min: "Min", median: "Median", max: "Max", mean: "Mean" }

a := func(priority, visibility, extra) {
	return maps.merge({
		"pl7.app/table/orderPriority": priority,
		"pl7.app/table/visibility": visibility
	}, extra)
}

chainDomain := func(chain) {
	return {
		"pl7.app/vdj/scClonotypeChain": PAIRED_DOMAIN[chain],
		"pl7.app/vdj/scClonotypeChain/index": "primary"
	}
}

keyAxis := func(blockId) {
	return {
		column: "variantKey",
		naRegex: "",
		spec: {
			type: "String",
			name: "pl7.app/variantKey",
			domain: {
				"pl7.app/blockId": blockId,
				"pl7.app/modality": "vdj",
				// The key hashes the nucleotide VDJRegion of both chains.
				"pl7.app/alphabet": "nucleotide",
				"pl7.app/identitySource": "derived",
				"pl7.app/vdj/receptor": RECEPTOR,
				"pl7.app/vdj/resolution": "receptor",
				// The chains are paired by the well, not seen together in a cell.
				"pl7.app/vdj/pairing": "declared",
				// The key always hashes a heavy and a light slot (one may be empty),
				// so the axis is a Heavy+Light receptor key whatever sides a run holds.
				"pl7.app/vdj/receptorChains": "Heavy+Light",
				"pl7.app/vdj/identityComponents": "VDJRegion~;VDJRegion~",
				// Kept until consumers read the keys above: clonotype-space, cdr3-spectratype
				// and vj-gene-usage tell an antibody variantKey axis apart by this key.
				"pl7.app/vdj/clonotypingRunId": blockId
			},
			annotations: {
				"pl7.app/label": "Variant Id",
				"pl7.app/table/fontFamily": "monospace",
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "110000"
			}
		}
	}
}

// The plate. A variant seen on two plates carries a count for each.
sampleAxis := func(blockId) {
	return {
		column: "sampleId",
		spec: {
			type: "String",
			name: "pl7.app/sampleId",
			domain: { "pl7.app/blockId": blockId },
			annotations: { "pl7.app/label": "Plate" }
		}
	}
}

// The scheme decides where each region ends. A consumer that checks conserved
// residues reads it from the region columns: the liabilities block, missing it,
// expects the cysteine at the start of CDR3, where only MiXCR's CDR3 has it.
sequenceColumns := func(scheme, chains) {
	columns := []
	priority := 46900
	for chain in chains {
		for f in FEATURES {
			for short, alphabet in ALPHABETS {
				// The whole domain in amino acids is what a reader means by
				// "the sequence", so it is the one marked as such.
				main := f == "VDJRegion" && short == "aa"
				extra := {
					"pl7.app/label": LABEL[chain] + " " + f + " " + short,
					"pl7.app/table/fontFamily": "monospace"
				}
				if main {
					extra["pl7.app/vdj/isMainSequence"] = "true"
					extra["pl7.app/vdj/isAssemblingFeature"] = "true"
				}
				domain := maps.merge({
					"pl7.app/alphabet": alphabet,
					"pl7.app/vdj/feature": f
				}, chainDomain(chain))
				if f != "VDJRegion" {
					domain["pl7.app/vdj/numberingSchema"] = scheme
					extra["pl7.app/vdj/numberingSchema"] = scheme
				}
				columns = append(columns, {
					column: SIDE[chain] + "_" + short + "_" + f,
					allowNA: true,
					spec: {
						name: "pl7.app/vdj/sequence",
						valueType: "String",
						domain: domain,
						annotations: a(string(priority),
							main || f == "CDR3" ? "default" : "optional", extra)
					}
				})
				priority = priority - 10
			}
		}
	}
	return columns
}

// The same names as MiXCR's clonotyping blocks: the gene without its allele is
// shown, the hit with its allele is offered.
geneColumns := func(chains) {
	columns := []
	priority := 45000
	for chain in chains {
		for g in GENES {
			for variant in [
				{ column: g.gene, name: "pl7.app/vdj/geneHit", label: " Gene", visibility: "default" },
				{ column: g.hit, name: "pl7.app/vdj/geneHitWithAllele", label: " Hit with Allele", visibility: "optional" }
			] {
				columns = append(columns, {
					column: SIDE[chain] + "_" + variant.column,
					allowNA: true,
					spec: {
						name: variant.name,
						valueType: "String",
						domain: maps.merge({ "pl7.app/vdj/reference": g.reference },
							chainDomain(chain)),
						annotations: a(string(priority), variant.visibility, {
							"pl7.app/label": LABEL[chain] + " " + g.label + variant.label,
							"pl7.app/isDiscreteFilter": "true"
						})
					}
				})
				priority = priority - 10
			}
		}
	}
	return columns
}

// The germline columns MiXCR adds, per side: the constant region's class, whether
// the chain is productive, and the somatic hypermutation of V and J. Named as
// mixcr-clonotyping names them. Isotype is a heavy-chain property (IgG/IgM/...), so it
// is emitted only for the heavy side; a light chain's class is its C gene (kappa/lambda).
germlineColumns := func(chains) {
	columns := []
	priority := 44500
	for chain in chains {
		if SIDE[chain] == "heavy" {
			columns = append(columns, {
				column: SIDE[chain] + "_isotype",
				allowNA: true,
				spec: {
					name: "pl7.app/vdj/isotype",
					valueType: "String",
					domain: chainDomain(chain),
					annotations: a(string(priority), "default", {
						"pl7.app/label": LABEL[chain] + " Isotype",
						"pl7.app/isDiscreteFilter": "true",
						"pl7.app/discreteValues": string(json.encode(ISOTYPES))
					})
				}
			})
			priority = priority - 10
		}

		columns = append(columns, {
			column: SIDE[chain] + "_productiveFlag",
			allowNA: true,
			spec: {
				name: "pl7.app/vdj/sequence/productive",
				valueType: "String",
				domain: chainDomain(chain),
				annotations: a(string(priority), "optional", {
					"pl7.app/label": LABEL[chain] + " Productive",
					"pl7.app/isDiscreteFilter": "true",
					"pl7.app/discreteValues": string(json.encode(["true", "false"]))
				})
			}
		})
		priority = priority - 10

		for m in MUTATIONS {
			domain := chainDomain(chain)
			if !is_undefined(m.gene) {
				domain = maps.merge({ "pl7.app/vdj/gene": m.gene }, chainDomain(chain))
			}
			extra := { "pl7.app/label": LABEL[chain] + " " + m.label }
			if !is_undefined(m.score) {
				extra["pl7.app/isScore"] = "true"
				extra["pl7.app/score/rankingOrder"] = m.score
			}
			if !is_undefined(m.format) {
				extra["pl7.app/format"] = m.format
			}
			columns = append(columns, {
				column: SIDE[chain] + "_" + m.field,
				allowNA: true,
				naRegex: "region_not_covered",
				spec: {
					name: m.name,
					valueType: m.type,
					domain: domain,
					annotations: a(string(priority), "optional", extra)
				}
			})
			priority = priority - 10
		}
	}
	return columns
}

// Length columns, matching mixcr-clonotyping: CDR3 lengths, the junction lengths,
// and the total added nucleotides. One per side.
lengthColumns := func(chains) {
	columns := []
	priority := 43500
	for chain in chains {
		for l in LENGTHS {
			domain := maps.merge({ "pl7.app/alphabet": l.alphabet }, chainDomain(chain))
			if !is_undefined(l.feature) {
				domain = maps.merge({ "pl7.app/vdj/feature": l.feature }, domain)
			}
			columns = append(columns, {
				column: SIDE[chain] + "_" + l.field,
				allowNA: true,
				naRegex: l.na,
				spec: {
					name: "pl7.app/vdj/sequenceLength",
					valueType: "Int",
					domain: domain,
					annotations: a(string(priority), "optional", {
						"pl7.app/label": LABEL[chain] + " " + l.label
					})
				}
			})
			priority = priority - 10
		}
	}
	return columns
}

// How much read sits outside the domain, per side (nucleotides), plus a note marking a
// flank larger than a V-plus-constant read explains. For traceability: the clone sequence
// is the domain only, so these show what real read it leaves out.
flankColumns := func(chains) {
	columns := []
	priority := 42500
	for chain in chains {
		for fl in FLANKS {
			columns = append(columns, {
				column: SIDE[chain] + "_" + fl.field,
				allowNA: true,
				naRegex: "^$",
				spec: {
					name: "pl7.app/vdj/readFlankLength",
					valueType: "Int",
					// The end the length measures from, so the 5' and 3' columns are told
					// apart by their spec, not only by their label.
					domain: maps.merge({
						"pl7.app/alphabet": "nucleotide",
						"pl7.app/vdj/readFlankEnd": fl.end
					}, chainDomain(chain)),
					annotations: a(string(priority), "optional", {
						"pl7.app/label": LABEL[chain] + " " + fl.label
					})
				}
			})
			priority = priority - 10
		}
		columns = append(columns, {
			column: SIDE[chain] + "_unusualFlank",
			allowNA: true,
			naRegex: "^$",
			spec: {
				name: "pl7.app/vdj/readFlankNote",
				valueType: "String",
				domain: chainDomain(chain),
				annotations: a(string(priority), "optional", {
					"pl7.app/label": LABEL[chain] + " Extra Read Beyond Domain",
					"pl7.app/isDiscreteFilter": "true"
				})
			}
		})
		priority = priority - 10
	}
	return columns
}

// The V/D/J/C coverage markup the sequence viewer reads, one per side. Hidden: it
// is machine-readable markup, not a table value. The value is a base-36 span
// string on the nucleotide VDJRegion; the mapping names each id's segment.
annotationColumns := func(chains) {
	columns := []
	priority := 43000
	for chain in chains {
		columns = append(columns, {
			column: SIDE[chain] + "_segmentsNt",
			allowNA: true,
			naRegex: "region_not_covered",
			spec: {
				name: "pl7.app/vdj/sequence/annotation",
				valueType: "String",
				domain: maps.merge({
					"pl7.app/vdj/feature": "VDJRegion",
					"pl7.app/alphabet": "nucleotide",
					"pl7.app/sequence/annotation/type": "Segments"
				}, chainDomain(chain)),
				annotations: a(string(priority), "hidden", {
					"pl7.app/label": LABEL[chain] + " V/D/J/C Segments",
					"pl7.app/sequence/isAnnotation": "true",
					"pl7.app/sequence/annotation/mapping": SEGMENTS_MAPPING
				})
			}
		})
		priority = priority - 10
	}
	return columns
}

// The germline over each chain's VDJRegion, one per side and alphabet, for the
// viewer's mismatch tracks. Hidden: it is read position-by-position against the
// sequence, not shown as a table value. The sample's own residue where it matches
// germline, the germline residue where it differs, a gap where no gene is templated.
GERMLINE_SEQUENCES := [
	{ field: "germlineNt", alphabet: "nucleotide", label: "Germline nt" },
	{ field: "germlineAa", alphabet: "aminoacid", label: "Germline aa" }
]

germlineSequenceColumns := func(chains) {
	columns := []
	priority := 42000
	for chain in chains {
		for g in GERMLINE_SEQUENCES {
			columns = append(columns, {
				column: SIDE[chain] + "_" + g.field,
				allowNA: true,
				spec: {
					name: "pl7.app/vdj/germlineSequence",
					valueType: "String",
					domain: maps.merge({
						"pl7.app/vdj/feature": "VDJRegion",
						"pl7.app/alphabet": g.alphabet
					}, chainDomain(chain)),
					annotations: a(string(priority), "hidden", {
						"pl7.app/label": LABEL[chain] + " " + g.label
					})
				}
			})
			priority = priority - 10
		}
	}
	return columns
}

// No vocabulary covers "could these two chains be held together", so the name
// is this block's own. It is a discrete filter, which is how a consumer keeps
// the ambiguous records out without this block having dropped them.
pairingColumn := func() {
	return {
		column: "pairStatus",
		allowNA: true,
		spec: {
			name: "pl7.app/vdj/clonePairing",
			valueType: "String",
			domain: {},
			annotations: a("44000", "optional", {
				"pl7.app/label": "Pairing",
				"pl7.app/isDiscreteFilter": "true"
			})
		}
	}
}

// The row label other blocks show, named and built as mixcr-clonotyping names
// and builds its own.
cloneIdColumn := func() {
	return {
		column: "cloneId",
		allowNA: false,
		spec: {
			name: "pl7.app/label",
			valueType: "String",
			domain: {},
			annotations: a("109500", "default", {
				"pl7.app/label": "Clone Id",
				"pl7.app/table/fontFamily": "monospace"
			})
		}
	}
}

wellsColumn := func() {
	return {
		column: "wells",
		allowNA: true,
		spec: {
			name: "pl7.app/vdj/wells",
			valueType: "String",
			domain: {},
			annotations: a("109000", "default", { "pl7.app/label": "Wells" })
		}
	}
}

abundanceColumn := func() {
	return {
		column: "wellCount",
		allowNA: false,
		spec: {
			// Platform-wide names, shared with every other block that reports an
			// abundance. They keep "molecule" where this block says "sequence".
			name: "pl7.app/vdj/uniqueMoleculeCount",
			valueType: "Long",
			domain: {},
			annotations: a("88000", "default", {
				"pl7.app/label": "Number of Wells",
				"pl7.app/min": "1",
				"pl7.app/isAbundance": "true",
				"pl7.app/abundance/unit": "molecules",
				"pl7.app/abundance/normalized": "false",
				"pl7.app/abundance/isPrimary": "true",
				"pl7.app/isAnchor": "true"
			})
		}
	}
}

// Each sheet column travels as the summaries of the wells behind the variant,
// plus the values as they stand and whether those wells disagreed.
propertyColumns := func(properties) {
	columns := []
	if is_undefined(properties) {
		return columns
	}
	for i, p in properties {
		token := strings.substituteSpecialCharacters(p.name)
		base := "prop_" + string(i)
		columns = append(columns, {
			column: base + "_values",
			allowNA: true,
			spec: {
				name: "pl7.app/vdj/importedProperty/" + token,
				valueType: "String",
				domain: { "pl7.app/vdj/importedProperty/summary": "perWell" },
				annotations: a("43000", "default",
					{ "pl7.app/label": p.name + " (per Well)" })
			}
		})
		columns = append(columns, {
			column: base + "_disagrees",
			allowNA: true,
			spec: {
				name: "pl7.app/vdj/importedProperty/" + token,
				valueType: "String",
				domain: { "pl7.app/vdj/importedProperty/summary": "disagrees" },
				annotations: a("42900", "optional", {
					"pl7.app/label": p.name + " Disagrees",
					"pl7.app/isDiscreteFilter": "true"
				})
			}
		})
		if p.type != "String" {
			for s in ["min", "median", "max", "mean"] {
				columns = append(columns, {
					column: base + "_" + s,
					allowNA: true,
					spec: {
						name: "pl7.app/vdj/importedProperty/" + token,
						valueType: "Double",
						domain: { "pl7.app/vdj/importedProperty/summary": s },
						annotations: a("42800", s == "max" ? "default" : "optional",
							{ "pl7.app/label": p.name + " " + SUMMARY_LABEL[s] })
					}
				})
			}
		}
	}
	return columns
}

// Tengo's `append` takes values, not a spliced array, so each group is folded
// in one at a time.
addAll := func(into, more) {
	for item in more {
		into = append(into, item)
	}
	return into
}

// `sides` lists the sides the set has sequences for. Undefined means both: a
// heavy-only set exports no light chain columns at all.
variantSettings := func(blockId, properties, scheme, sides) {
	chains := CHAINS
	if !is_undefined(sides) {
		chains = []
		for side in sides {
			chains = append(chains, CHAIN_OF[side])
		}
	}
	columns := [cloneIdColumn(), wellsColumn(), pairingColumn()]
	columns = addAll(columns, sequenceColumns(scheme, chains))
	columns = addAll(columns, geneColumns(chains))
	columns = addAll(columns, germlineColumns(chains))
	columns = addAll(columns, lengthColumns(chains))
	columns = addAll(columns, flankColumns(chains))
	columns = addAll(columns, annotationColumns(chains))
	columns = addAll(columns, germlineSequenceColumns(chains))
	columns = addAll(columns, propertyColumns(properties))
	return {
		axes: [keyAxis(blockId)],
		columns: columns,
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

// Partitioned on the plate axis. A consumer that splits this column addresses the
// plate by its partition key, and an unpartitioned column has the single empty key
// `[]`, so index 0 does not exist and the split yields nothing.
abundanceSettings := func(blockId) {
	return {
		axes: [sampleAxis(blockId), keyAxis(blockId)],
		columns: [abundanceColumn()],
		storageFormat: "Parquet",
		partitionKeyLength: 1
	}
}

// The trace is what names the dataset everywhere downstream. Without it a
// consumer falls back to the anchor column's own label, so the set shows up
// called after whatever that column happens to be.
//
// makeTrace eats its first argument as the upstream trace and treats only the
// rest as steps. This block has no upstream, so an empty map stands in;
// passing the step alone silently produces an empty trace.
datasetTrace := func(blockId, label) {
	return pSpec.makeTrace({}, {
		type: "milaboratories.clone-annotation",
		id: blockId,
		importance: 30,
		label: label
	})
}

// The `.ab1` read the sequence viewer shows for one chain of a variant. Hidden: it is a
// file, not something a table or a chart can show.
traceFileColumn := func(blockId, side) {
	chain := side == "heavy" ? "IGHeavy" : "IGLight"
	return {
		kind: "PColumn",
		name: "pl7.app/vdj/sequence/traceFile",
		valueType: "File",
		domain: maps.merge({ "pl7.app/fileExtension": "ab1" }, chainDomain(chain)),
		axesSpec: [keyAxis(blockId).spec],
		annotations: {
			"pl7.app/label": LABEL[chain] + " Trace File",
			"pl7.app/hideDataFromUi": "true"
		}
	}
}

export {
	datasetTrace: datasetTrace,
	traceFileColumn: traceFileColumn,
	variantSettings: variantSettings,
	abundanceSettings: abundanceSettings
}
