// The p-column shape of the clone table: one row per well, its two chains
// side by side.

FEATURES := ["VDJRegion", "FR1", "CDR1", "FR2", "CDR2", "FR3", "CDR3", "FR4"]
SIDES := ["heavy", "light"]
PER_SIDE := ["chain", "source", "length", "meanQuality", "regionStatus",
	"vGene", "dGene", "jGene"]

LABELS := {
	chain: "chain", source: "source", length: "length",
	meanQuality: "mean Q", regionStatus: "regions",
	vGene: "V gene", dGene: "D gene", jGene: "J gene"
}

TYPES := {
	chain: "String", source: "String", length: "Long",
	meanQuality: "Double", regionStatus: "String",
	vGene: "String", dGene: "String", jGene: "String"
}

// The clone is read as an antibody: what its two CDR3s are and where they
// came from. Everything else is in the column chooser.
SHOWN := {
	plate: true, well: true, pairStatus: true,
	heavy_chain: true, heavy_vGene: true, heavy_jGene: true, heavy_aa_CDR3: true,
	light_chain: true, light_vGene: true, light_jGene: true, light_aa_CDR3: true
}

axisSpec := {
	name: "pl7.app/vdj/cloneKey",
	type: "String",
	annotations: { "pl7.app/label": "Clone" }
}

priority := func(column) {
	order := {
		plate: 1000, well: 990, pairStatus: 980,
		heavy_chain: 910, heavy_vGene: 900, heavy_jGene: 890, heavy_aa_CDR3: 880,
		light_chain: 875, light_vGene: 870, light_jGene: 860, light_aa_CDR3: 850
	}
	if !is_undefined(order[column]) {
		return order[column]
	}
	return 500
}

col := func(column, valueType, label) {
	return {
		column: column,
		spec: {
			valueType: valueType,
			name: "pl7.app/vdj/clone/" + column,
			annotations: {
				"pl7.app/label": label,
				"pl7.app/table/visibility": SHOWN[column] == true ? "default" : "optional",
				"pl7.app/table/orderPriority": string(priority(column))
			}
		}
	}
}

settings := func() {
	columns := [
		col("plate", "String", "Plate"),
		col("well", "String", "Well"),
		col("pairStatus", "String", "Pairing")
	]

	for side in SIDES {
		title := side == "heavy" ? "Heavy" : "Light"
		for f in PER_SIDE {
			columns = append(columns,
				col(side + "_" + f, TYPES[f], title + " " + LABELS[f]))
		}
		for f in FEATURES {
			columns = append(columns,
				col(side + "_aa_" + f, "String", title + " " + f + " aa"))
		}
		for f in FEATURES {
			columns = append(columns,
				col(side + "_nt_" + f, "String", title + " " + f + " nt"))
		}
	}

	return {
		axes: [{ column: "cloneKey", spec: axisSpec }],
		columns: columns,
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

export {
	axisSpec: axisSpec,
	settings: settings
}
