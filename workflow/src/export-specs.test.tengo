test := import("@platforma-sdk/workflow-tengo:test")
exportSpecs := import(":export-specs")

// Two chains, eight features, two alphabets.
SEQUENCE_COLUMNS := 32
// Two chains, V, D, J and C, each as a gene and as a hit with its allele.
GENE_COLUMNS := 16
// Two chains, each with productive and twelve mutation columns, plus isotype on the
// heavy side only (a light chain has no isotype).
GERMLINE_COLUMNS := 27
// Two chains, each with CDR3 nt/aa length, three junction lengths and total added.
LENGTH_COLUMNS := 12
// Two chains, each with a 5' and 3' flank length and an unusual-flank note.
FLANK_COLUMNS := 6
// Two chains, each with a V/D/J/C segments annotation.
ANNOTATION_COLUMNS := 2
// Two chains, each with a germline nucleotide and amino-acid sequence for the mismatch tracks.
GERMLINE_SEQUENCE_COLUMNS := 4
// Clone Id, wells and pairing.
FIXED_COLUMNS := 3

countOf := func(settings, name) {
	n := 0
	for c in settings.columns {
		if c.spec.name == name {
			n++
		}
	}
	return n
}

TestVariantSettingsBuildEveryColumn := func() {
	s := exportSpecs.variantSettings("blk", undefined, "imgt", undefined)
	test.isEqual(SEQUENCE_COLUMNS + GENE_COLUMNS + GERMLINE_COLUMNS + LENGTH_COLUMNS + FLANK_COLUMNS + ANNOTATION_COLUMNS + GERMLINE_SEQUENCE_COLUMNS + FIXED_COLUMNS, len(s.columns))
	test.isEqual(SEQUENCE_COLUMNS, countOf(s, "pl7.app/vdj/sequence"))
	test.isEqual(GENE_COLUMNS / 2, countOf(s, "pl7.app/vdj/geneHit"))
	test.isEqual(GENE_COLUMNS / 2, countOf(s, "pl7.app/vdj/geneHitWithAllele"))
	// Only the heavy chain carries an isotype; both carry a productivity flag and the V
	// and J mutation counts and rates.
	test.isEqual(1, countOf(s, "pl7.app/vdj/isotype"))
	test.isEqual(2, countOf(s, "pl7.app/vdj/sequence/productive"))
	test.isEqual(4, countOf(s, "pl7.app/vdj/sequence/nMutationsCount"))
	test.isEqual(4, countOf(s, "pl7.app/vdj/sequence/nMutationsRate"))
	test.isEqual(2, countOf(s, "pl7.app/vdj/sequence/fractionCDRMutations"))
	// Both chains carry the six length columns.
	test.isEqual(LENGTH_COLUMNS, countOf(s, "pl7.app/vdj/sequenceLength"))
	// Both chains carry a 5' and 3' flank length and an unusual-flank note.
	test.isEqual(4, countOf(s, "pl7.app/vdj/readFlankLength"))
	test.isEqual(2, countOf(s, "pl7.app/vdj/readFlankNote"))
	// Both chains carry a segments annotation.
	test.isEqual(ANNOTATION_COLUMNS, countOf(s, "pl7.app/vdj/sequence/annotation"))
	// Both chains carry a germline sequence for the mismatch track.
	test.isEqual(GERMLINE_SEQUENCE_COLUMNS, countOf(s, "pl7.app/vdj/germlineSequence"))
}

TestTheSegmentsAnnotationMatchesTheViewerContract := func() {
	s := exportSpecs.variantSettings("blk", undefined, "imgt", ["heavy"])
	for c in s.columns {
		if c.column == "heavy_segmentsNt" {
			test.isEqual("pl7.app/vdj/sequence/annotation", c.spec.name)
			test.isEqual("VDJRegion", c.spec.domain["pl7.app/vdj/feature"])
			test.isEqual("nucleotide", c.spec.domain["pl7.app/alphabet"])
			test.isEqual("Segments", c.spec.domain["pl7.app/sequence/annotation/type"])
			test.isEqual("A", c.spec.domain["pl7.app/vdj/scClonotypeChain"])
			test.isEqual("true", c.spec.annotations["pl7.app/sequence/isAnnotation"])
			test.isEqual("hidden", c.spec.annotations["pl7.app/table/visibility"])
		}
	}
}

TestMutationColumnsMatchClonotyping := func() {
	s := exportSpecs.variantSettings("blk", undefined, "imgt", ["heavy"])
	for c in s.columns {
		if c.column == "heavy_vNtMutCount" {
			test.isEqual("pl7.app/vdj/sequence/nMutationsCount", c.spec.name)
			test.isEqual("Int", c.spec.valueType)
			test.isEqual("V", c.spec.domain["pl7.app/vdj/gene"])
			test.isEqual("A", c.spec.domain["pl7.app/vdj/scClonotypeChain"])
			test.isEqual("region_not_covered", c.naRegex)
		}
		if c.column == "heavy_nMutations" {
			test.isEqual("pl7.app/vdj/sequence/nMutations", c.spec.name)
			test.isEqual("true", c.spec.annotations["pl7.app/isScore"])
			test.isEqual("decreasing", c.spec.annotations["pl7.app/score/rankingOrder"])
			test.isTrue(is_undefined(c.spec.domain["pl7.app/vdj/gene"]), "a score has no gene domain")
		}
	}
}

TestTheGeneIsShownAndTheAlleleOffered := func() {
	s := exportSpecs.variantSettings("blk", undefined, "imgt", ["heavy"])
	for c in s.columns {
		if c.column == "heavy_vGene" {
			test.isEqual("pl7.app/vdj/geneHit", c.spec.name)
			test.isEqual("default", c.spec.annotations["pl7.app/table/visibility"])
		}
		if c.column == "heavy_vHit" {
			test.isEqual("pl7.app/vdj/geneHitWithAllele", c.spec.name)
			test.isEqual("optional", c.spec.annotations["pl7.app/table/visibility"])
			test.isEqual("VGene", c.spec.domain["pl7.app/vdj/reference"])
		}
	}
}

TestTheRecordKeyIsTheOnlyAxis := func() {
	s := exportSpecs.variantSettings("blk", undefined, "imgt", undefined)
	test.isEqual(1, len(s.axes))
	test.isEqual("pl7.app/variantKey", s.axes[0].spec.name)
}

TestTheKeyAxisNamesItsRunAndModality := func() {
	domain := exportSpecs.variantSettings("blk", undefined, "imgt", undefined).axes[0].spec.domain
	test.isEqual("blk", domain["pl7.app/blockId"])
	test.isEqual("vdj", domain["pl7.app/modality"])
	test.isEqual("blk", domain["pl7.app/vdj/clonotypingRunId"])
}

TestTheKeyAxisCarriesTheVdjShape := func() {
	domain := exportSpecs.variantSettings("blk", undefined, "imgt", undefined).axes[0].spec.domain
	test.isEqual("nucleotide", domain["pl7.app/alphabet"])
	test.isEqual("derived", domain["pl7.app/identitySource"])
	test.isEqual("IG", domain["pl7.app/vdj/receptor"])
	test.isEqual("receptor", domain["pl7.app/vdj/resolution"])
	test.isEqual("declared", domain["pl7.app/vdj/pairing"])
	test.isEqual("Heavy+Light", domain["pl7.app/vdj/receptorChains"])
	test.isEqual("VDJRegion~;VDJRegion~", domain["pl7.app/vdj/identityComponents"])
}

// The variants, abundance and trace-file frames must share one axis, so the axis
// spec each builds has to be identical.
TestEveryFrameSharesTheKeyAxis := func() {
	variant := exportSpecs.variantSettings("blk", undefined, "imgt", undefined).axes[0].spec
	abundance := exportSpecs.abundanceSettings("blk").axes[1].spec
	trace := exportSpecs.traceFileColumn("blk", "heavy").axesSpec[0]
	test.isEqual(variant.domain, abundance.domain)
	test.isEqual(variant.domain, trace.domain)
}

TestTheChainsAreSeparatedByDomainNotByAxis := func() {
	s := exportSpecs.variantSettings("blk", undefined, "imgt", undefined)
	sides := {}
	for c in s.columns {
		if c.spec.name == "pl7.app/vdj/sequence" {
			sides[c.spec.domain["pl7.app/vdj/scClonotypeChain"]] = true
		}
	}
	test.isEqual(true, sides["A"])
	test.isEqual(true, sides["B"])
}

TestRegionsCarryTheScheme := func() {
	s := exportSpecs.variantSettings("blk", undefined, "kabat", undefined)
	for c in s.columns {
		if c.spec.name != "pl7.app/vdj/sequence" {
			continue
		}
		f := c.spec.domain["pl7.app/vdj/feature"]
		if f == "VDJRegion" {
			test.isTrue(is_undefined(c.spec.domain["pl7.app/vdj/numberingSchema"]), "no scheme on the whole domain")
		} else {
			test.isEqual("kabat", c.spec.domain["pl7.app/vdj/numberingSchema"], f)
			test.isEqual("kabat", c.spec.annotations["pl7.app/vdj/numberingSchema"], f)
		}
	}
}

TestAPropertyBringsItsValuesAndItsSummaries := func() {
	props := [{ name: "elisa", type: "Double", values: {} }]
	s := exportSpecs.variantSettings("blk", props, "imgt", undefined)
	// values, disagrees, and four summaries.
	test.isEqual(SEQUENCE_COLUMNS + GENE_COLUMNS + GERMLINE_COLUMNS + LENGTH_COLUMNS + FLANK_COLUMNS + ANNOTATION_COLUMNS + GERMLINE_SEQUENCE_COLUMNS + FIXED_COLUMNS + 6, len(s.columns))
}

TestALabelGetsNoSummaries := func() {
	props := [{ name: "note", type: "String", values: {} }]
	s := exportSpecs.variantSettings("blk", props, "imgt", undefined)
	test.isEqual(SEQUENCE_COLUMNS + GENE_COLUMNS + GERMLINE_COLUMNS + LENGTH_COLUMNS + FLANK_COLUMNS + ANNOTATION_COLUMNS + GERMLINE_SEQUENCE_COLUMNS + FIXED_COLUMNS + 2, len(s.columns))
}

TestAbundanceCarriesTheSampleAxisFirst := func() {
	s := exportSpecs.abundanceSettings("blk")
	test.isEqual(2, len(s.axes))
	test.isEqual("pl7.app/sampleId", s.axes[0].spec.name)
	test.isEqual("pl7.app/variantKey", s.axes[1].spec.name)
	test.isEqual(1, len(s.columns))
}

// A consumer splits the abundance column on the plate axis. An unpartitioned
// column has the single empty key `[]`, so index 0 does not exist there.
TestAbundanceIsPartitionedOnThePlateAxis := func() {
	test.isEqual(1, exportSpecs.abundanceSettings("blk").partitionKeyLength)
}

TestVariantColumnsAreNotPartitioned := func() {
	test.isEqual(0, exportSpecs.variantSettings("blk", undefined, "imgt", undefined).partitionKeyLength)
}

// makeTrace eats its first argument as the upstream trace, so a source block
// that passes only its step gets an empty one and every consumer falls back to
// the anchor column's own label.
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")

TestASourceBlockTraceIsNotEmpty := func() {
	trace := pSpec.makeTrace({}, { type: "t", id: "b", importance: 30, label: "My Set" })
	test.isEqual(1, len(trace.value))
	test.isEqual("My Set", trace.value[0].label)
}

TestTheTraceReachesTheColumnSpec := func() {
	trace := pSpec.makeTrace({}, { type: "t", id: "b", importance: 30, label: "My Set" })
	// `inject` takes a whole p-column spec, which the xsv settings only become
	// once imported, so the shape is built here rather than borrowed.
	spec := {
		kind: "PColumn",
		name: "pl7.app/vdj/sequence",
		valueType: "String",
		domain: {},
		axesSpec: [],
		annotations: { "pl7.app/label": "Wells" }
	}
	injected := trace.inject(spec)
	test.isTrue(injected.annotations["pl7.app/trace"] != "[]")
	test.isTrue(injected.annotations["pl7.app/trace"] != undefined)
}

TestAHeavyOnlySetExportsNoLightChain := func() {
	s := exportSpecs.variantSettings("blk", undefined, "imgt", ["heavy"])
	test.isEqual(SEQUENCE_COLUMNS / 2, countOf(s, "pl7.app/vdj/sequence"))
	test.isEqual(GENE_COLUMNS / 4, countOf(s, "pl7.app/vdj/geneHit"))
	test.isEqual(GENE_COLUMNS / 4, countOf(s, "pl7.app/vdj/geneHitWithAllele"))
	for c in s.columns {
		if c.spec.name == "pl7.app/vdj/sequence" || c.spec.name == "pl7.app/vdj/geneHit" ||
			c.spec.name == "pl7.app/vdj/geneHitWithAllele" {
			test.isEqual("A", c.spec.domain["pl7.app/vdj/scClonotypeChain"])
		}
	}
}
