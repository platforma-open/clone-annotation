help := import(":result-help")

// The p-column shape of the pair table: one row per well, its two chains
// side by side.

FEATURES := ["VDJRegion", "FR1", "CDR1", "FR2", "CDR2", "FR3", "CDR3", "FR4"]
SIDES := ["heavy", "light"]
PER_SIDE := ["chain", "fileChain", "source", "length", "meanQuality", "regionStatus",
	"vGene", "dGene", "jGene"]

LABELS := {
	chain: "Chain", fileChain: "Chain in File Name", source: "Source", length: "Length",
	meanQuality: "Mean Quality", regionStatus: "Regions",
	vGene: "V Gene", dGene: "D Gene", jGene: "J Gene"
}

TYPES := {
	chain: "String", fileChain: "String", source: "String", length: "Long",
	meanQuality: "Double", regionStatus: "String",
	vGene: "String", dGene: "String", jGene: "String"
}

// The pair is read as an antibody: what its two CDR3s are and where they
// came from. Everything else is in the column chooser.
SHOWN := {
	plate: true, well: true, pairStatus: true, qcReason: true,
	heavy_chain: true, heavy_vGene: true, heavy_jGene: true, heavy_aa_CDR3: true,
	light_chain: true, light_vGene: true, light_jGene: true, light_aa_CDR3: true
}

// Plate and Well already say which row it is; the key adds nothing to read.
axisSpec := {
	name: "pl7.app/vdj/pairId",
	type: "String",
	annotations: {
		"pl7.app/label": "Pair",
		"pl7.app/table/visibility": "hidden"
	}
}

priority := func(column) {
	order := {
		plate: 1000, well: 990, pairStatus: 980, qcReason: 975,
		heavy_chain: 910, heavy_vGene: 900, heavy_jGene: 890, heavy_aa_CDR3: 880,
		light_chain: 875, light_vGene: 870, light_jGene: 860, light_aa_CDR3: 850
	}
	if !is_undefined(order[column]) {
		return order[column]
	}
	return 500
}

col := func(column, valueType, label) {
	annotations := {
		"pl7.app/label": label,
		"pl7.app/table/visibility": SHOWN[column] == true ? "default" : "optional",
		"pl7.app/table/orderPriority": string(priority(column))
	}
	description := help.describe(help.PAIR, column)
	if !is_undefined(description) {
		annotations["pl7.app/description"] = description
	}
	return {
		column: column,
		spec: {
			valueType: valueType,
			name: "pl7.app/vdj/pair/" + column,
			annotations: annotations
		}
	}
}

// `sides` lists the sides the set has sequences for. Undefined means both.
settings := func(sides) {
	if is_undefined(sides) {
		sides = SIDES
	}

	columns := [
		col("plate", "String", "Plate"),
		col("well", "String", "Well"),
		col("pairStatus", "String", "Pairing"),
		col("qcReason", "String", "QC Reason")
	]

	for side in sides {
		title := side == "heavy" ? "Heavy" : "Light"
		for f in PER_SIDE {
			columns = append(columns,
				col(side + "_" + f, TYPES[f], title + " " + LABELS[f]))
		}
		for f in FEATURES {
			columns = append(columns,
				col(side + "_aa_" + f, "String", title + " " + f + " aa"))
		}
		for f in FEATURES {
			columns = append(columns,
				col(side + "_nt_" + f, "String", title + " " + f + " nt"))
		}
	}

	return {
		axes: [{ column: "pairId", spec: axisSpec }],
		columns: columns,
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}
}

export {
	axisSpec: axisSpec,
	settings: settings
}
